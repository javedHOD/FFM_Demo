# ── Phase 2.4: MIS Category Sync ────────────────────────────────
# External MIS endpoint that returns the master category list.
# Expected response shape (any of these is accepted):
#   [ { mis_id|id|categoryId: "...", name|category_name: "...", code?, description? }, ... ]
#   { data:   [ ... ] }
#   { items:  [ ... ] }
#   { result: [ ... ] }
MIS_CATEGORY_API_URL=
# Optional bearer token sent as Authorization header when calling MIS:
MIS_API_KEY=

# ── Phase 2.5: MIS Product Sync ─────────────────────────────────
# External MIS endpoint that returns the master product list.
# Each item must contain at minimum:
#   { mis_id|id, name, category_id|categoryMisId, ...optional code, description, unit_price, uom }
MIS_PRODUCT_API_URL=
